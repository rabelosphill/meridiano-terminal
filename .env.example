# Meridiano — configuração de exemplo (sem segredos). Copie para .env e exporte antes de rodar.

# dev | test | prod. Em prod o feed simulado é desligado por padrão e reset_schema é bloqueado.
FT_ENV=dev

# PostgreSQL. Se ausente em dev/test, sobe um PostgreSQL 16 embutido (pgserver) em ./.pgdata
# DATABASE_URL=postgresql://meridiano:CHANGE_ME@localhost:5432/meridiano

# Armazenamento de objetos (documentos e payloads originais, endereçados por sha256)
FT_OBJECT_STORE=./data/objects
FT_SNAPSHOT_DIR=./data/snapshot

# live | snapshot | auto (tenta a rede e cai para o snapshot identificado por data e origem)
FT_DATA_MODE=auto

# A SEC exige User-Agent identificando o responsável (nome + e-mail de contato da sua organização)
SEC_USER_AGENT="SuaEmpresa Research contato@suaempresa.example"

# Feed simulado de cotações (apenas dev/test; marcado SIMULADO em toda a interface)
FT_SIM_FEED=1
FT_SIM_IGNORE_HOURS=1
FT_QUOTE_STALE_SECONDS=30

# Histórico OHLCV dos EUA (opcional, licenciado). Sem chave, gráficos de ações americanas ficam "indisponível".
# TIINGO_API_KEY=
